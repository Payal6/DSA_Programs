class Solution
{
    public static Node removeNthFromEnd(Node head, int k) {
    Node dummy = new Node(-1);
    dummy.next = head;
    Node t1 = dummy;
    Node t2 = dummy;
    for(int i = 0 ; i < k ; i++){
        t2 = t2.next;
    }
    while(t2.next!=null){
        t1 = t1.next;
        t2 = t2.next;
    }
    t1.next = t1.next.next;
    return dummy.next;
        
