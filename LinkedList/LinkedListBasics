    }
    static Node insertAtTail(Node head, int val){
        Node nn = new Node(val);
        if(head==null){
            //head=nn;
            return nn;
            //return head;
        }
        Node temp = head;
        while(temp.next!=null){
            temp = temp.next;
        }
        temp.next = nn;
        return head;
    }
    static Node insertAtKthPosition(Node head, int k , int val){
        if(head == null){
            if(k==1){
                Node nn = new Node (val);
                return nn;
            }else{
                return null;
            }
        }
        if(k==1){
            Node nn = new Node(val);
            nn.next = head;
            return nn;
        }
        Node temp = head;
        int c = 1;
        while(temp!=null&&c!=(k-1)){
            temp = temp.next;
        }
        Node nn = new Node(val);
        nn.next = temp.next;
        temp.next = nn;
        return head;
    }
